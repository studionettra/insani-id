# ==============================================================
# Insani Indonesia — Production Environment (Hostinger Business)
# ==============================================================
# Copy this file to .env on your Hostinger server and fill in
# the actual values. NEVER commit .env to version control.
# ==============================================================

APP_NAME="Insani Indonesia"
APP_ENV=production
APP_KEY=                          # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://insani.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ---
# Daily rotation keeps disk usage in check on shared hosting
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (dari hPanel → Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost                 # Biasanya localhost di Hostinger shared
DB_PORT=3306
DB_DATABASE=                      # Nama database dari hPanel
DB_USERNAME=                      # Username dari hPanel
DB_PASSWORD=                      # Password dari hPanel
DUMP_BINARY_PATH=/usr/bin         # Path binary mysqldump untuk backup otomatis di Hostinger

# --- Session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=insani.id
SESSION_SECURE_COOKIE=true

# --- Services ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Inertia SSR ---
# Shared hosting tidak mendukung persistent Node.js process
INERTIA_SSR_ENABLED=false

# --- Mail (Hostinger SMTP) ---
# Opsi 1 (Port 465 - SSL): MAIL_SCHEME=smtps, MAIL_PORT=465
# Opsi 2 (Port 587 - TLS): MAIL_SCHEME=tls, MAIL_PORT=587
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=notifikasi@insani.id
MAIL_PASSWORD=                    # Password email notifikasi dari hPanel
MAIL_FROM_ADDRESS="notifikasi@insani.id"
MAIL_FROM_NAME="Insani Indonesia"
MAIL_REPLY_TO_ADDRESS="sapa@insani.id"
MAIL_REPLY_TO_NAME="Layanan Sahabat Insani"

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"

# --- Cloudflare Turnstile (PRODUCTION keys dari dashboard.cloudflare.com) ---
VITE_TURNSTILE_SITE_KEY=         # Production site key
TURNSTILE_SECRET_KEY=            # Production secret key

# --- Midtrans Payment Gateway (PRODUCTION keys dari dashboard.midtrans.com) ---
MIDTRANS_MERCHANT_ID=            # Production Merchant ID
MIDTRANS_CLIENT_KEY=             # Production Client Key (Mid-client-...)
MIDTRANS_SERVER_KEY=             # Production Server Key (Mid-server-...)
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_EXPIRY_QRIS_MINUTES=30
MIDTRANS_EXPIRY_VA_HOURS=24

# --- Xendit Payment Gateway (Legacy / Deprecated) ---
XENDIT_API_KEY=                  # Production API key (xnd_production_...)
XENDIT_WEBHOOK_TOKEN=            # Production webhook verification token

